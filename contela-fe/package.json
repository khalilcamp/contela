{
  "name": "contela-fe",
  "version": "0.1.4",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "concurrently -k \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:static": "cross-env ELECTRON=1 next build && electron . --static",
    "electron:build": "cross-env ELECTRON=1 next build && electron-builder",
    "test:integracao": "node tests/integracao/executar.cjs"
  },
  "dependencies": {
    "application-loopback": "^1.2.7",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@stomp/stompjs": "^7.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sockjs-client": "^1.5.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sockjs-client": "^1.6.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.contela.app",
    "productName": "Contela",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Contela",
        "schemes": [
          "contela"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Contela-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Contela-${version}-portatil.${ext}"
    },
    "asarUnpack": [
      "node_modules/application-loopback/bin/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "khalilcamp",
        "repo": "contela"
      }
    ]
  }
}
